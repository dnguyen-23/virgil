def T = UnitTests.registerT("partial evaluation:", _, PartialEvaluatorTester.new, _);
def X = [
	T("if and if-else stmt", testIfStmts),
	T("for loop", testForLoop),
	T("switch", testSwitch),
	()
];

def DEBUG = true;

class MockedPartialEvaluator extends PartialEvaluator {
	var expectedPath: List<PathType>;
	def assertHelpers: AssertHelpers;
	var t: Tester;
	private def headerToIter = HashMap<SsaBlock, int>.new(SsaBlock.uid, SsaBlock.==);
	new(blockOrder: SsaBlockOrder, instrReducer: SsaInstrReducer, assertHelpers) super(blockOrder, instrReducer) {
		t = assertHelpers.t;
		expectedPath = assertHelpers.expectedPath;
	}

	def evaluate() { 
		def ordering: Vector<SsaBlock> = blockOrder.order;
		if (ordering.length == 0) return;
		worklist = Lists.cons1<SsaBlock>(ordering[0]);
		while (worklist != null) {
			assertCorrectPathChoice(worklist.head);
			evalSsaBlock();
		}
		if (expectedPath != null) t.fail("Expected all paths traversed");
		if (DEBUG) Terminal.put("Finished partial evaluation\n\n");
	}

	def popFromExpectedPath() -> PathType {
		if (expectedPath == null) {
			t.fail("No expected branches left but evaluation unfinished");
			return PathType.IfBranch(false);
		}
		def expectedChoice: PathType = expectedPath.head;
		expectedPath = expectedPath.tail;
		return expectedChoice;
	}


	def expectedIfBranchMatchesTraversed(
		ifInstr: SsaIf, 
		curBlock: SsaBlock,
		expected: PathType
	) {
		def pred = ifInstr.block();
		def depth = Lists.length(loopStack);
		for (i < depth) Terminal.put("\t");
		match (expected) {
			IfBranch => {
				Terminal.put("Tester: Expecting If branch traversal\n");
				def ifPath = PathType.IfBranch.!(expected);
				def expectedBranch = ifPath.branch;
				def curBranch = ifInstr.trueBlock() == curBlock;
				if (expectedBranch != curBranch) {
					def msg = Strings.format2("Expected traversal of %z branch but %z branch was explored instead.", expectedBranch, curBranch);
					t.fail(msg);
				}
				// Check if exiting a loop. Reset iter count if so
				if (assertHelpers.headerToBackedge.has(pred) && !expectedBranch) {
					headerToIter.remove(pred);
				}
			}
			ForILoop => {
				Terminal.put("Tester: Expecting For loop branch traversal\n");
				def loopPath = PathType.ForILoop.!(expected);
				if (!assertHelpers.headerToBackedge.has(pred)) {
					def msg = Strings.format1("Expected traversal of loop but not currently entering a loop body. Block uid: %d", curBlock.uid);
					t.fail(msg);
				}
				var curIter = 0;
				if(headerToIter.has(pred)) {
					headerToIter[pred]++;
					curIter = headerToIter[pred];
				} else {
					headerToIter[pred] = 0;
				}
				if (curIter != loopPath.i) {
					def msg = Strings.format3("Expected to be at iteration %d but currently at iteration %d with loop header block %d", loopPath.i, curIter, pred.uid);
					t.fail(msg);
				}
			}
			SwitchCase => {
				def msg = "Expected traversal of switch case but traversing if-stmt";
				t.fail(msg);
			}
		}
	}

	def expectedSwitchBranchMatchesTraversed(
		switchInstr: SsaSwitch,
		curBlock: SsaBlock,
		expected: PathType
	) {
		if (!PathType.SwitchCase.?(expected)) {
			def msg = "Unexpected traversal of switch branch";
			t.fail(msg);
		}
		def expectedCond = PathType.SwitchCase.!(expected).v;
		def expectedSucc = switchInstr.findSucc(expectedCond).dest;
		if (expectedSucc == curBlock) return;

		// Failure: Determine which branch curBlock starts
		def intExpectedCond = Int.unbox(expectedCond);
		for (i = 0; i < switchInstr.succs.length; i++) {
			def succI = switchInstr.succs[i].dest;
			if (succI == curBlock) {
				def msg = Strings.format3("Expected traversal of switch case %d but traversed case %d instead at block %d", intExpectedCond, i, curBlock.uid);
				t.fail(msg);
				return;
			}
		}
		def msg = Strings.format2("Expected traversal of switch case %d but current block %d is not part of a switch case", intExpectedCond, curBlock.uid);
		t.fail(msg);
	}

	def assertCorrectPathChoice(curBlock: SsaBlock) {
		if (curBlock.preds.length != 1) return;
		def predEnd: SsaEnd = curBlock.preds[0].src;
		def pred: SsaBlock = predEnd.block();
		match (predEnd) {
			x: SsaIf => {
				def expected: PathType = popFromExpectedPath();	
				expectedIfBranchMatchesTraversed(x, curBlock, expected);
			   }
			x: SsaSwitch => {
				def expected: PathType = popFromExpectedPath();	
				expectedSwitchBranchMatchesTraversed(x, curBlock, expected);
			   }
		}


	}
}

// Easy input format for creating tests
type CFGSpec {
	case Switch(cond: Array<SsaInstr>, branches: Array<CFGSpec>);
	case If(cond: Array<SsaInstr>, trueBranch: CFGSpec, falseBranch: CFGSpec);
	case IfSingleBranch(cond: Array<SsaInstr>, trueBranch: CFGSpec);
	case Loop(numIter: SsaInstr, body: CFGSpec);
	case Block(instrs: Array<SsaInstr>);
	case End(val: int);
}

// Outputs from generating the CFG from the spec that will be useful for testing
type CFGSpecsToGraphOutput(
	graph: SsaGraph, 
	headerToBackedge: HashMap<SsaBlock, SsaGoto>	
) {}

type PathType {
	case IfBranch(branch: bool);
	case ForILoop(i: int);
	case SwitchCase(v: Val);
}

// Objects that help with the assertion we need to make
type AssertHelpers(
	t: Tester, 
	headerToBackedge: HashMap<SsaBlock, SsaGoto>,
	expectedPath: List<PathType>
) {
	def isLoopHeader(block: SsaBlock) -> bool {
		return headerToBackedge.has(block);
	}
}

/**
 * Defines funtionality for testing the partial evaluator
 */
class PartialEvaluatorTester(t: Tester) {
	var graph: SsaGraph;
	var builder: SsaBuilder;
	var headerToBackedge: HashMap<SsaBlock, SsaGoto>;

	/**
	 * Checks that the SSA CFG was traversed correctly.
	 * 
	 * Takes as input a thunk for generating the SSA CFG
	 * to partially evaluate. 
	 */
	def assertCorrectTraversal(
		genCFG: SsaBlock -> SsaBlock,
		expected: Array<PathType>
	) {
		graph = SsaGraph.new([], Int.TYPE);
		builder = SsaBuilder.new(null, graph, graph.startBlock);
		headerToBackedge = HashMap<SsaBlock, SsaGoto>.new(SsaBlock.uid, SsaBlock.==);
		genCFG(graph.startBlock);

		UnitTests.fatal = true;
		
		if (DEBUG) {
			def printer = SsaPrinter.new();
			printer.printGraph(null, null, graph, null);
			// t.fail("asdf");
		}
		def marker = SsaInternalMarker.new();
		marker.graph = graph;
		def blockOrder = SsaBlockOrder.new(graph, false, marker);
		def instrReducer = SsaInstrReducer.new(null);
		instrReducer.graph = graph;
		def assertHelpers = AssertHelpers(t, headerToBackedge, Lists.fromArray(expected));
		def mockPE = MockedPartialEvaluator.new(blockOrder, instrReducer, assertHelpers);
		mockPE.evaluate();

	}
	
	
	// Functionality for constructing CFGs for testing 

	/**
	 * Branches from the current block into `numBranches` branches 
	 * Returns an array ofthe start block for each branch. 
	 * `condInstrs` is an array of instructions for constructing the 
	 * condition that the CFG branches on.
	 */
	def branch(
		curBlock: SsaBlock, 
		numBranches: int,
		condInstrs: Array<SsaInstr>   
	) -> Array<SsaBlock> {
		if (condInstrs == null || condInstrs.length == 0) {
			t.fail("Unable to create condition instruction.");
		}
		if (curBlock == null) {
			t.fail("Start block is null");
		}

		builder.set(curBlock);
		for (i in condInstrs) {
			if (SsaConst.?(i)) continue;
			builder.append(i);
		}
	
		def cond = condInstrs[condInstrs.length - 1];

		if (numBranches == 2) {
			// Use an if-stmt when there's only 2 cases
			def trueBlock = SsaBlock.new();
			def falseBlock = SsaBlock.new();
			builder.addIf(cond, trueBlock, falseBlock);
			return [trueBlock, falseBlock];
		}

		// Use a switch when there's more than 2 cases 
		def keyType = cond.getType();
		// switch creation automatically adds 2
		def maxValue = numBranches - 2;
		def switch = SsaSwitch.new(keyType, maxValue, cond);
		for (i < switch.succs.length) {
			switch.succs[i] = SsaCfEdge.new(switch, SsaBlock.new());
		}
		builder.append(switch);
		def succs = Arrays.map(switch.succs, SsaCfEdge.dest);

		return succs;
	}

	/** 
	 * Merges a set of predecessors at the given merge block.
	 * Builder sets the current block to be the merge block.
	 */
	def mergePredsIntoBlock(preds: Array<SsaBlock>, mergeBlock: SsaBlock) {
		for (p in preds) {
			builder.set(p);
			builder.addGoto(mergeBlock);
		}
		builder.set(mergeBlock);
	}

	/** 
	 * Merges the branches specified in each subarray of `toMerge`.
	 * Returns an array of merge blocks where the ith block corresponds
	 * to the merge block where the blocks in `toMerge[i]` meet.
	 */
	def merge(toMerge: Array<Array<SsaBlock>>) -> Array<SsaBlock> {
		def mergeBlocks = Vector<SsaBlock>.new();
		for (blocksToMerge in toMerge) {
			def merge = SsaBlock.new();
			mergePredsIntoBlock(blocksToMerge, merge);
			mergeBlocks.put(merge);
		}
		return mergeBlocks.extract();
	}

	/**
	 * Returns whether the SSA CFG is in split edge form. 
	 * This means that there are no critical edges in the SSA CFG.
	 * Updates the phi function representing the iterator variable
	 * with the correct argument.
	 */
	def isSplitEdgeForm() -> bool {
		// Stores an explored block and whether it 
		// satisfies split edge form
		def explored = Ssa.newBlockMap<bool>();
		var stack = List.new(graph.startBlock, null);
		var allBlocksSplitEdge = true;
		while (stack != null) {
			def block = stack.head;
			stack = stack.tail;
			// Get successors and cache the ones that
			// haven't been explored
			def succs = Arrays.map(block.succs(), SsaCfEdge.dest);
			for (b in succs) {
				if (explored.has(b)) continue;
				stack = List.new(b, stack);
			}

			def cfToBlock = fun (cf: SsaCfEdge) => cf.src.block();
			def predBlocks = Arrays.map(block.preds, cfToBlock);

			// Check if any predecessors have multiiple successors
			for (p in predBlocks) {
				if (p.succs().length > 0) {
					if (!DEBUG) return false;
					explored[block] = false;
					allBlocksSplitEdge = false;
					continue;
				}
			}
			explored[block] = true;
		}

		if (DEBUG && !allBlocksSplitEdge) {
			if (!allBlocksSplitEdge) {
				def keys = Maps.keyList(explored);
				Terminal.put("The following blocks had predecessors with multiple successors");
				for (l = keys; l != null; l = l.tail) {
					def block = l.head;
					if (explored[block]) continue;
					Terminal.put1("\tBlock %d\n", block.uid);
				}
				return false;
			}
			Terminal.put("CFG is in split edge form\n");
		} 

		return true;
	}

	/**
	 * Replaces the temporary phi function that was added in the header
	 * block with a new phi function whose args are the initial value
	 * of the phi function and the instructions from other update blocks
	 */
	def addLoopBackedge(
		headerBlock: SsaBlock, 
		updateBlock: SsaBlock,
		oldPhi: SsaPhi,
		updateInstr: SsaInstr
	) {
		// Add the SsaGoto from the updateBlock to header
		builder.set(updateBlock);
		builder.addGoto(headerBlock);

		headerToBackedge[headerBlock] = SsaGoto.!(updateBlock.end());

		def oldArgs = Arrays.map(oldPhi.inputs, SsaDfEdge.dest);
		def newArgs = Arrays.append(updateInstr, oldArgs);
		def newPhi = SsaPhi.new(oldPhi.getType(), oldPhi.block, newArgs);
		oldPhi.replace(newPhi);
		newPhi.insertBefore(oldPhi);
		oldPhi.remove();

	}

	/**
	 * Generates an if-else stmt. 
	 * 
	 * `condInstrs` contains the instructions for setting up 
	 * the condition. The last instruction in `condInstrs` should
	 * be the condition itself.
	 * 
	 * Returns a tuple where the first element is the block
	 * performing the branching and the second element is the 
	 * merge block.
	 */
	def genIfElseConstStmt(
		condVal: bool,
		genTrue: SsaBlock -> SsaBlock,
		genFalse: SsaBlock -> SsaBlock,
		curBlock: SsaBlock
	) -> SsaBlock {
		def condInstrs = runtimeConstCond(condVal);
		def branchBlocks = branch(curBlock, 2, condInstrs);
		def trueEndBlock = genTrue(branchBlocks[0]);
		def falseEndBlock = genFalse(branchBlocks[1]);
		def mergeBlocks = merge([[trueEndBlock, falseEndBlock]]);
		def mergeBlock = mergeBlocks[0];
		builder.set(mergeBlock);
		return mergeBlock;
	}

	def genIfStmt(
		condVal: bool,
		genTrue: SsaBlock -> SsaBlock,
		curBlock: SsaBlock
	) -> SsaBlock {
		def condInstrs = runtimeConstCond(condVal);
		def branchBlocks = branch(curBlock, 2, condInstrs);
		def falseBlock = branchBlocks[1];

		def trueBlock = branchBlocks[0];
		def trueEndBlock = genTrue(trueBlock);

		builder.addGoto(falseBlock);
		builder.set(falseBlock);

		return falseBlock;
	}

	def genForLoop(
		numIter: int, 
		genBody: SsaBlock -> SsaBlock, 
		curBlock: SsaBlock
	) -> SsaBlock {
		builder.set(curBlock);
		def header = SsaBlock.new();

		builder.addGoto(header);
		builder.set(header);

		def tempPhi = SsaPhi.new(Int.TYPE, header, [graph.intConst(0)]);
		def limit = graph.intConst(numIter);
		def cond = SsaApplyOp.new(null, Int.TYPE.opLt(), [tempPhi, limit]);
		def branchBlocks = branch(header, 2, [tempPhi, cond]);
		def exitBlock = branchBlocks[1];

		def loopBodyStart = branchBlocks[0];
		def loopBodyEnd = genBody(loopBodyStart);

		def updateInstr = SsaApplyOp.new(null, Int.TYPE.opAdd(), [tempPhi, graph.intConst(1)]);
		builder.append(updateInstr);
		
		addLoopBackedge(header, loopBodyEnd, tempPhi, updateInstr);
		builder.set(exitBlock);
		return exitBlock;
	}

	def genForLoopWithIfElseStmt(
		numIter: int,
		cond: bool,
		curBlock: SsaBlock
	) -> SsaBlock {
		def nestedIf = genIfElseConstStmt(cond, genBlock, genBlock, _);
		return genForLoop(numIter, nestedIf, curBlock);
	}

	def genForLoopWithForLoop(
		numIterOuter: int,
		numIterInner: int,
		curBlock: SsaBlock
	) -> SsaBlock {
		def nestedLoop = genForLoop(numIterInner, genBlock, _);
		return genForLoop(numIterOuter, nestedLoop, curBlock);
	}
		
	def genIfElseWithForLoops(
		cond: bool,
		numIter: int,
		curBlock: SsaBlock
	) -> SsaBlock {
		def genLoop = genForLoop(numIter, genBlock, _);
		return genIfElseConstStmt(cond, genLoop, genLoop, curBlock);
	}

	def genSwitch(
		cond: int, 
		branchFuncs: Array<SsaBlock -> SsaBlock>,
		curBlock: SsaBlock
	) -> SsaBlock {
		def endBlocks = Array<SsaBlock>.new(branchFuncs.length);
		def intCond = graph.intConst(cond);
		def numBranches = branchFuncs.length;
		def branchStarts = branch(curBlock, numBranches, [intCond]);
		for (i = 0; i < numBranches; i++) {
			endBlocks[i] = branchFuncs[i](branchStarts[i]);
		}
		def mergeBlock = merge([endBlocks])[0];
		return mergeBlock;
	}

	def genBlock(curBlock: SsaBlock) -> SsaBlock { 
		builder.set(curBlock);
		return curBlock;
	}

	def runtimeConstCond(cond: bool) -> Array<SsaInstr> {
		def op = V3Op.opBoolEq;
		def trueConst = graph.boolConst(true);
		def falseConst = graph.boolConst(false);
		def args: Array<SsaInstr> = if(cond, [trueConst, trueConst], [trueConst, falseConst]);
		def condInstr = SsaApplyOp.new(null, op, args);
		return [condInstr];
	}

}

type TestParams(boolParams: Array<SsaParam>, intParams: Array<SsaParam>){
	// Helper for indexing into the boolParams array
	def getBool(i: int) -> SsaParam { return boolParams[i]; }
	
	// Helper for indexing into the intParams array
	def getInt(i: int) -> SsaParam { return intParams[i]; }

	// Concatenates bool params + int params. Bools come first, then ints
	def toArray() -> Array<SsaParam> { return Arrays.concat(boolParams, intParams); }
}
def TRUE = PathType.IfBranch(true);
def FALSE = PathType.IfBranch(false);
def LOOP = (fun (i: int) => PathType.ForILoop(i));
def CASE = (fun (i: int) => PathType.SwitchCase(Int.box(i)));

def testIfStmts(t: PartialEvaluatorTester) {
	t.assertCorrectTraversal(t.genIfElseConstStmt(true, t.genBlock, t.genBlock, _), [TRUE, FALSE]);
	t.assertCorrectTraversal(t.genIfElseConstStmt(false, t.genBlock, t.genBlock, _), [TRUE, FALSE]);
	t.assertCorrectTraversal(t.genIfStmt(false, t.genBlock, _), [TRUE]);
	t.assertCorrectTraversal(t.genIfStmt(true, t.genBlock, _), [TRUE]);
}

def testForLoop(t: PartialEvaluatorTester) {
	t.assertCorrectTraversal(t.genForLoop(3, t.genBlock, _), [LOOP(0), LOOP(1), LOOP(2), FALSE]);
	t.assertCorrectTraversal(t.genForLoopWithIfElseStmt(3, true, _), [LOOP(0), TRUE, FALSE, LOOP(1), TRUE, FALSE, LOOP(2), TRUE, FALSE, FALSE]);
	t.assertCorrectTraversal(t.genForLoopWithForLoop(2, 3, _), [LOOP(0), LOOP(0), LOOP(1), LOOP(2), FALSE, LOOP(1), LOOP(0), LOOP(1), LOOP(2), FALSE, FALSE]);
	t.assertCorrectTraversal(t.genIfElseWithForLoops(true, 3, _), [TRUE, LOOP(0), LOOP(1), LOOP(2), FALSE, FALSE, LOOP(0), FALSE]);
	t.assertCorrectTraversal(t.genIfElseWithForLoops(false, 3, _), [TRUE, LOOP(0), FALSE, FALSE, LOOP(0), LOOP(1), LOOP(2), FALSE]);
}

def testSwitch(t: PartialEvaluatorTester) {
	t.assertCorrectTraversal(t.genSwitch(2, [t.genBlock, t.genBlock, t.genBlock], _), [CASE(0), CASE(1), CASE(2)]);
	t.assertCorrectTraversal(t.genSwitch(2, [t.genBlock, t.genForLoop(10, t.genBlock, _), t.genBlock], _), [CASE(0), CASE(1), LOOP(0), FALSE, CASE(2)]);
	t.assertCorrectTraversal(t.genSwitch(1, [t.genBlock, t.genForLoop(3, t.genBlock, _), t.genBlock], _), [CASE(0), CASE(1), LOOP(0), LOOP(1), LOOP(2), FALSE, CASE(2)]);
	t.assertCorrectTraversal(t.genSwitch(0, [t.genForLoop(3, t.genBlock, _), t.genBlock, t.genBlock], _), [CASE(0), LOOP(0), LOOP(1), LOOP(2), FALSE, CASE(1), CASE(2)]);
	t.assertCorrectTraversal(t.genSwitch(1, [t.genForLoop(3, t.genBlock, _), t.genBlock, t.genBlock], _), [CASE(0), LOOP(0), FALSE, CASE(1), CASE(2)]);
	t.assertCorrectTraversal(t.genSwitch(2, [t.genBlock, t.genBlock, t.genForLoop(3, t.genBlock, _)], _), [CASE(0), CASE(1), CASE(2), LOOP(0), LOOP(1), LOOP(2), FALSE]);
}
