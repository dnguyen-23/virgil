/**
 * Defines a partial evaluator where given a set of inputs, 
 * the partial evaluator will evaluate as much of the program 
 * as it can. The partial evaluator should output a specialized 
 * version of the program. 
 */
class PartialEvaluator {
	// ----------------- Constants -----------------
	def DEBUG = true;
	// ----------------- Helpers -----------------
	def blockOrder: SsaBlockOrder;
	def instrReducer: SsaInstrReducer;
	var worklist: List<SsaBlock>;
	def blockContextsMap = Ssa.newBlockMap<List<PEBlockContext>>();
	def headerToLoop = Ssa.newBlockMap<SsaLoopInfo>();
	var loopStack: List<LoopIterInfo>;

	new (blockOrder, instrReducer) {
		// Construct SRPO 
		blockOrder.computeDominators();
		// Construct header to loop map for loop identification later
		def allLoopInfo: Vector<SsaLoopInfo> = blockOrder.loops;
		if (allLoopInfo != null) {
			for (i = 0; i < allLoopInfo.length; i++) {
				def loopInfo = allLoopInfo[i];
				def header: SsaBlock = blockOrder.order[loopInfo.start];
				headerToLoop[header] = loopInfo;
			}
		}
	}

	def evaluate() { 
		def ordering: Vector<SsaBlock> = blockOrder.order;
		if (ordering.length == 0) return;
		worklist = Lists.cons1<SsaBlock>(ordering[0]);
		while (worklist != null) evalSsaBlock();
		if (DEBUG) Terminal.put("Finished partial evaluation\n\n");
	}

	/**
	 * Returns the most recent context created for a block
	 */
	def getLatestBlockContext(block: SsaBlock) -> PEBlockContext {
		if (!blockContextsMap.has(block)) return null;
		def contextList = blockContextsMap[block];
		return if (contextList == null, null, contextList.head);
	}

	/**
	 * Adds a new block context for the block
	 */
	def addNewBlockContextToMap(block: SsaBlock, newContext: PEBlockContext) {
		def oldContextList = blockContextsMap[block];
		blockContextsMap[block] = List.new(newContext, oldContextList);
	}

	def intersect(
		m1: PartialMap<OptMapKey, SsaInstr>, 
		m2: PartialMap<OptMapKey, SsaInstr>
	) -> PartialMap<OptMapKey, SsaInstr> {
		def keys1 = Maps.keyList(m1);
		def keys2 = Maps.keyList(m2);
		if (keys1 == null) return m2;
		if (keys2 == null) return m1;
		def keys = if(Lists.length(keys1) < Lists.length(keys2), keys1, keys2);
		def newMap = HashMap<OptMapKey, SsaInstr>.new(OptMapKey.hash, OptMapKey.equals);
		for (l = keys; l != null; l = l.tail) {
			def k = l.head;
			def bothHaveKey = m1.has(k) && m2.has(k);
			if (!bothHaveKey) continue;
			def m1Val = m1[k];
			def m2Val = m2[k];
			var sameInstr = m1Val == m2Val;
			if (SsaApplyOp.?(m1Val) && SsaApplyOp.?(m2Val)) {
				// Already know inputs and operator are the 
				// same because OptMapKey is the same
				sameInstr = true;
			}
			if (!sameInstr) continue;
			newMap[k] = m1Val;
		}

		return newMap;
	}

	def mergeContexts(preds: Array<SsaBlock>) -> PEBlockContext {
		if (preds.length == 0) return null;
		def predContext = getLatestBlockContext(preds[0]);
		if (predContext == null) throwNoContextsFound(preds[0]);
		if (preds.length == 1) return PEBlockContext.new(predContext);

		var resultMap: PartialMap<OptMapKey, SsaInstr> = predContext.optMap;
		for (i = 1; i < preds.length; i++) {
			def context = getLatestBlockContext(preds[i]);
			if (context == null) throwNoContextsFound(preds[i]);
			resultMap = intersect(resultMap, context.optMap);
		}
		def mergedContext = PEBlockContext.new(null);
		mergedContext.optMap = HashMap<OptMapKey, SsaInstr>.!(resultMap);
		return mergedContext;
	}


	/**
	 * Takes the contexts of the live predecessors and 
	 * merges the contexts together to create the context for
	 * the current block.
	 */
	def mergeLivePredContexts(block: SsaBlock) -> PEBlockContext {
		def cfToBlock = fun (cf: SsaCfEdge) => cf.src.block();
		def allPredBlocks = Arrays.map(block.preds, cfToBlock);
		def cond = fun (b: SsaBlock) => getLatestBlockContext(b).live;
		def livePreds = Arrays.filter(allPredBlocks, cond);
		if (livePreds.length == 0) throwNoLivePredsFound(block);
		def mergedContext = mergeContexts(livePreds);
		addNewBlockContextToMap(block, mergedContext);
		return mergedContext;
	}

	/**
	 * Takes the context of a predecessor block and copies it 
	 * to create the context for the current block.
	 */
	def copyPredContext(block: SsaBlock, predIdx: int) -> PEBlockContext {
		def cfEdge: SsaCfEdge = block.preds[predIdx];
		def pred: SsaBlock = cfEdge.src.block();
		def latestPredContext = getLatestBlockContext(pred);
		if (latestPredContext == null) throwNoContextsFound(pred);
		def newContext = PEBlockContext.new(latestPredContext);
		addNewBlockContextToMap(block, newContext);
		return newContext;
	}

	/**
	 * Iterates over the predecessors of a block to check if 
	 * the current block is live.
	 */
	def arePredsDead(block: SsaBlock) -> bool {
		var isDead = true;
		for (p in block.preds) {
			def predBlock = p.src.block();
			def predContext = getLatestBlockContext(predBlock);
			if (predContext.live) isDead = false;
			if (DEBUG) {
				def status = if(predContext.live, "live", "dead");
				Terminal.put2("\t\tPred %d is %s\n", predBlock.uid, status);
			}
		}
		if (DEBUG) {
			def status = if(!isDead, "live", "dead");
			Terminal.put2("\tBlock %d is %s\n", block.uid, status);
		}
		return isDead;
	}

	/**
	 * Checks if the current block is the start block of a dead branch
	 * for a branching instruction.
	 */
	def startsDeadBranch(block: SsaBlock) -> bool {
		if (block.preds.length != 1 &&
		   !SsaIf.?(block.preds[0].src) && 
		   !SsaSwitch.?(block.preds[0].src)) {
			return false;
		}
		// Check the condition
		def predEnd = block.preds[0].src;
		def origCond = predEnd.inputs[0].dest;
		def predContext = getLatestBlockContext(predEnd.block());
		def cond = predContext.getOptInstr(origCond);
		if (SsaIf.?(predEnd)) {
			def ifStmt = SsaIf.!(predEnd);
			if (!SsaConst.?(cond)) {
				if (DEBUG) Terminal.put2("\tBlock %d starts var condition branch of if-stmt %d\n", block.uid, ifStmt.uid);
				return false;
			}
			def rawCond = Bool.unbox(SsaConst.!(cond).val);
			if ((rawCond && block == ifStmt.trueBlock()) ||
			    (!rawCond && block == ifStmt.falseBlock())) {
				if (DEBUG) Terminal.put3("\tBlock %d starts live %z branch of if-stmt %d\n", block.uid, rawCond, ifStmt.uid);
				return false;
			}
			if (DEBUG) Terminal.put3("\tBlock %d starts dead %z branch of if-stmt %d\n", block.uid, rawCond, ifStmt.uid);
			return true;
		}
		// SsaSwitch
		def switchStmt = SsaSwitch.!(predEnd);
		if (!SsaConst.?(cond)) {
			if (DEBUG) Terminal.put2("\tBlock %d starts var condition branch of switch-stmt %d\n", block.uid, switchStmt.uid);
			return false;
		}
		// TODO: case on switches of different types
		if (cond.getType() != Int.TYPE) return false;
		def rawCond = Int.unbox(SsaConst.!(cond).val);
		def liveSuccBlock = switchStmt.succs[rawCond].dest;
		if (block == liveSuccBlock) {
			if (DEBUG) Terminal.put3("\tBlock %d starts live %d branch of if-stmt %d\n", block.uid, rawCond, switchStmt.uid);
			return false;
		}
		if (DEBUG) Terminal.put3("\tBlock %d starts dead %d branch of if-stmt %d\n", block.uid, rawCond, switchStmt.uid);
		return true;
	}

	/**
	 * Creates a block context for the block given information about it.
	 */
	def createContextForBlock(block: SsaBlock) -> PEBlockContext {
		if (DEBUG) Terminal.put1("createContextForBlock  %d.\n", block.uid);
		if (block.preds.length == 0) {
			// Base case: Start block in CFG
			if (DEBUG) Terminal.put("\tRoot context case.\n");
			def newContext = PEBlockContext.new(null);
			addNewBlockContextToMap(block, newContext);
			return newContext;
		}

		// Check whether the block is live or dead
		if (DEBUG) Terminal.put1("\tChecking if block %d is live:\n", block.uid);
		if (arePredsDead(block) || startsDeadBranch(block)) {
			def newContext = PEBlockContext.new(null);
			newContext.live = false;
			addNewBlockContextToMap(block, newContext);
			return newContext;
		}


		if (block.preds.length > 1) {
			// Merge block
			if (!headerToLoop.has(block)) {
				// Not a loop merge block
				if (DEBUG) Terminal.put("\tNot loop merge block\n");
				return mergeLivePredContexts(block);
			} 
			// Merge block is a loop header block
			if (DEBUG) Terminal.put("\tLoop merge block\n");
			if (!loopStack.head.hasLoopEvalStarted) {
				// Loop body untraversed. Entering loop
				def newContext = copyPredContext(block, 0);
				return newContext;

			}
			// Loop body traversed
			def mergedContext = mergeLivePredContexts(block);
			addNewBlockContextToMap(block, mergedContext);
			return mergedContext;
		}
		// Build context off of sole predecessor
		def newContext = copyPredContext(block, 0);
		return newContext;
	}

	/**
	 * Updates the loop stack by popping off stale loops. 
	 */
	def popStaleLoopsFromStack(block: SsaBlock) {
		var curIterInfo: LoopIterInfo = loopStack.head;
		var curLoopInfo: SsaLoopInfo = curIterInfo.info;
		def isInLoop = blockOrder.isInLoop(block, _);
		while (loopStack != null && !isInLoop(curLoopInfo.index)) {
			loopStack = loopStack.tail;
			if (loopStack != null) {
				curLoopInfo = loopStack.head.info;
			}
		}
	}

	/**
	 * Uses the current block to determine whether or not we have 
	 * left the current loop or entered a new loop.
	 */
	def updateLoopStack(block: SsaBlock) {
		if (loopStack != null) popStaleLoopsFromStack(block);
		// Non-header blocks cannot start new loop or iteration
		if (!headerToLoop.has(block)) return;

		// New loop
		def curLoopInfo: SsaLoopInfo = headerToLoop[block];
		def iterInfo = LoopIterInfo.new(curLoopInfo);
		loopStack = List.new(iterInfo, loopStack);
		return;
	}

	def isMergeBlockPred(block: SsaBlock) -> bool {
		def end = block.end();
		if (!SsaGoto.?(end)) return false;
		def goto = SsaGoto.!(end);
		return goto.target().preds.length > 1;
	}

	/**
	 * Checks whether all intructions in the vector are the same.
	 */
	def areInstrsConstant(instrVec: Vector<SsaInstr>) -> bool {
		def first = instrVec[0];
		for (i = 1; i < instrVec.length; i++) {
			if (first != instrVec[i]) return false;
		}
		return true;
	}

	/**
	 * Receives the optimized input to a phi function, given the 
	 * phi and the block it resides in.
	 */
	def getOptPhiInput(
		phi: SsaPhi, 
		block: SsaBlock, 
		predIdx: int
	) -> SsaInstr {
		def predBlock = block.preds[predIdx].src.block();
		def predContext = getLatestBlockContext(predBlock);
		def arg: SsaInstr = phi.inputs[predIdx].dest;
		def optArg: SsaInstr = predContext.getOptInstr(arg);
		return optArg;
	}


	/**
	 * Evaluate SsaPhi in non-loop header 
	 */
	def evalSsaPhi(
		phi: SsaPhi, 
		block: SsaBlock, 
		blockContext: PEBlockContext
	) {
		// SsaPhi represents a loop variable
		def curIter: LoopIterInfo = loopStack.head;
		if (!curIter.hasLoopEvalStarted) {
			// Take the first input to phi if loop not started
			def optArg = getOptPhiInput(phi, block, 0);
			blockContext.addPhi(phi, optArg);
			return;
		}
		// NOTE: need to consider predecessor contexts because
		// context merging could have left out phi input instrs

		def numInputs = phi.inputs.length;
		def cfToPred = (fun (cf: SsaCfEdge) => cf.src.block());
		def predBlocks = Arrays.map(block.preds, cfToPred);
		def predContexts = Arrays.map(predBlocks, getLatestBlockContext);
		def liveInputs = Vector<SsaInstr>.new();
		// If predecessor block wasn't traversed, skip
		for (i = 0; i < numInputs; i++) {
			if (!predContexts[i].live) continue;
			def optArg = getOptPhiInput(phi, block, i);
			liveInputs.put(optArg);
		}
		if (liveInputs.length == 0) throwNoLivePredsFound(block);
		// Check if all inputs end up being the same
		if (areInstrsConstant(liveInputs)) {
			blockContext.addPhi(phi, liveInputs[0]);
			return;
		}
		// No simplifications possible
		blockContext.addPhi(phi, phi); 
		// TODO: If not constant, try to extract facts
	}


	/** 
	 * Evaluate SsaGoto
	 */
	def evalSsaGoto(goto: SsaGoto) {
		def target: SsaBlock = goto.target();
		def curBlock: SsaBlock = goto.block();
		// Check if goto target is next in SRPO ordering
		// If next, then push the target to the worklist
		if (curBlock.info.srpo_num + 1 == target.info.srpo_num) {
			worklist = List.new(target, worklist);
			return;
		}
		// Else noop: there's an input branch we need to evaluate first
		// Should have been enqueued when evaluating the if-stmt block
	}

	/**
	 * Evaluate SsaIf
	 */
	def evalSsaIf(ifStmt: SsaIf) {
		if (DEBUG) Terminal.put1("SsaIf uid: %d\n", ifStmt.uid);
		if (DEBUG) Terminal.put2("\ttrueBlock: %d | falseBlock: %d\n", ifStmt.trueBlock().uid, ifStmt.falseBlock().uid);
		worklist = List<SsaBlock>.new(ifStmt.falseBlock(), worklist);
		worklist = List<SsaBlock>.new(ifStmt.trueBlock(), worklist);
		if (headerToLoop.has(ifStmt.block())) {
			loopStack.head.hasLoopEvalStarted = true;
		}
	}
	
	/**
	 * Evaluate the next block in the worklist. 
	 */
	def evalSsaBlock() {
		if (worklist == null) return;
		def block: SsaBlock = worklist.head;
		updateLoopStack(block);

		// TODO: identifiers for reusing contexts
		def blockContext = createContextForBlock(block);
		worklist = worklist.tail;

		// Skip to the end if the context is dead
		if (!blockContext.live) {
			evalSsaEnd(block.end(), blockContext);
			return;
		}

		if (DEBUG) Terminal.put1("\nevalSsaBlock uid: %d\n", block.uid);
		for (instr = block.next; instr != block; instr = instr.next) {
			match (instr) {
				x: SsaApplyOp => blockContext.addApplyOp(x, instrReducer);
				x: SsaPhi => evalSsaPhi(x, block, blockContext);
				x: SsaEnd => evalSsaEnd(x, blockContext); 
			}
		}
		if (DEBUG) Terminal.put2("\tContext for block %d:\n%q\n", block.uid, blockContext.render);
		return;
	}

	// Returns the SRPO index to resume partial evaluation at 
	def evalSsaEnd(end: SsaEnd, blockContext: PEBlockContext) {
		// Partial evaluator is called after switches have been lowered to if statements
		match (end) {
			x: SsaReturn, 
			x: SsaThrow => return; // TODO: how do we know when to end
			x: SsaIf => evalSsaIf(x);
			x: SsaGoto => evalSsaGoto(x);
			_ => return;
		}
	}

	def throwNoLivePredsFound(block: SsaBlock) {
		def msg = Strings.format1("Expected traversal of predecessors before merge block %d.\n", block.uid);
		System.error("PartialEvaluatorException", msg);
	}

	def throwOptInstrNotFound(i: SsaInstr) {
		def msg = Strings.format1("Instruction %d not found in block context\n", i.uid);
		System.error("PartialEvaluationFailedException", msg);
	}

	def throwNoContextsFound(block: SsaBlock) {
		def msg = Strings.format1("Block %d has no context", block.uid);
		System.error("PartialEvaluationException", msg);
	}
}

/**
 * Used to track information about the current iteration of the loop
 * the partial evaluator is in. Tracks the merge blocks that we will 
 * traverse and the predecessors that have been traversed in this iteration.
 */
class LoopIterInfo (info: SsaLoopInfo) {
	var hasLoopEvalStarted = false;
}

type OptMapKey(instr: SsaInstr, inputs: Array<SsaInstr>) {
	/**
	 * Implicitly takes as input an additional OptMapKey when called
	 * off of the type identifier
	 */
	def hash() -> int {
		var hashResult: int = 0;
		match (instr) {
			x: SsaApplyOp => {
				hashResult = x.op.opcode.tag;
			   }
			x: SsaPhi => {
				// There are much less opcodes than this
				hashResult = 300;
			   }
			x: SsaParam => {
				hashResult = 301;
			   }
			_ => {
				def msg = Strings.format1("Unsupported instruction type for instr: %d.\n", instr.uid);
				System.error("PartialEvaluationException", msg);
				return -1;
			}
		}
		for (i in inputs) hashResult = hashResult * 33 + i.uid;
		return hashResult;
	}

	/**
	 * Implicitly takes as input an OptMapKey additional when called
	 * off of the type identifier
	 */
	def equals(that: OptMapKey) -> bool {
		match (that.instr) {
			x: SsaApplyOp => {
				if (!SsaApplyOp.?(this.instr)) return false;
				if (x.op != SsaApplyOp.!(this.instr).op) return false;
				return  Arrays.allTrue(this.inputs, that.inputs, SsaInstr.==);
			   }
			x: SsaParam,
			x: SsaPhi => return this.instr == that.instr;
			_ => return false;
		}
	}

	def render(buf: StringBuilder) -> StringBuilder {
		match (instr) {
			x: SsaApplyOp => {
				x.op.render(buf);
				buf.puts(" | ");
			   }
			x: SsaPhi => {
				buf.put1("Phi %d | ", x.uid);
			   }
			x: SsaParam => {
				buf.put1("Param %d | ", x.uid);
			   }

		}
		for (i = 0; i < inputs.length; i++) {
			def instr = inputs[i];
			buf.put1("uid: %d", instr.uid);
			if (i != (inputs.length - 1)) buf.puts(" | ");
		}
		return buf;
	}
}

// PE stands for "Partial Evaluation"
/**
 * Why keep optimization info map for each context? 
 * Alternative: specialize the code
 * MVP: ensure traversal is correct
 * Afterward, it's possible we already have a specialization 
 * we want to continue using. Instead of overspecializing, 
 * it's possible we instead want to assume something is 
 * constant for evaluating but assume different things
 * are constant when specializing
 *
 * How do you use the map: replace all usages with the 
 * instruction we map to.
 */
class PEBlockContext {
	var optMap = HashMap<OptMapKey, SsaInstr>.new(OptMapKey.hash, OptMapKey.equals);
	var live: bool = true;
	new(predContext: PEBlockContext) {
		if (predContext != null) {
			optMap = Maps.copy<OptMapKey, SsaInstr>(predContext.optMap);
			live = predContext.live;
		}
	}

	def render(buf: StringBuilder) -> StringBuilder {
		buf.puts("\topt info map:\n");
		def keyList: List<OptMapKey> = Maps.keyList(optMap);
		for (l = keyList; l != null; l = l.tail) {
			def key = l.head;
			buf.put2("\t\t(%q)   ->    uid %d\n", key.render, optMap[key].uid);
		}
		buf.puts("\tend of map\n");
		buf.put1("\tblock liveness: %z\n", live);
		return buf;
	}
	
	def instrToOptMapKey(instr: SsaInstr) -> OptMapKey {
		def dfEdges = instr.inputs;
		def args = Arrays.map(dfEdges, SsaDfEdge.dest);
		return OptMapKey(instr, args);
	}

	/**
	 * Prints an array of instructions
	 */
	def printArgs(args: Array<SsaInstr>) {
		Terminal.put("\targs: ");
		for (a in args) Terminal.put1("%d ", a.uid);
		Terminal.put("\n");
	}

	/** 
	 * Returns the instruction with the optimized version of 
	 * each argument. 
	 */
	def optimizeArgs(i: SsaApplyOp) -> SsaApplyOp {
		Terminal.put1("optimizeArgs %d\n", i.uid);
		def newArgs = Arrays.map(i.inputs, dfEdgeToInstr);
		printArgs(newArgs);
		// TODO: transfer facts
		return SsaApplyOp.new(i.source, i.op, newArgs);
	}

	/**
	 * Adds an SsaApplyOp operation to the optimization map
	 */
	def addApplyOp(i: SsaApplyOp, instrReducer: SsaInstrReducer) -> SsaInstr {
		def origKey: OptMapKey = instrToOptMapKey(i);
		// Check if instr is already in map
		if (optMap.has(origKey)) return optMap[origKey];
		// Optimize args and update map
		def iWithOptArgs = optimizeArgs(i);
		def reducedInstr = instrReducer.reduceApplyOp(iWithOptArgs);
		def optArgsKey: OptMapKey = instrToOptMapKey(iWithOptArgs);
		Terminal.put3( "uid %d : (%q)   ->   uid %d\n", i.uid, origKey.render, reducedInstr.uid);
		// Update map with instruction -> optimize instruction pairings
		// to increase chance of opt map hits
		optMap[origKey] = reducedInstr;
		optMap[optArgsKey] = reducedInstr;
		if (!SsaConst.?(reducedInstr)) {
			def reducedKey: OptMapKey = instrToOptMapKey(reducedInstr);
			optMap[reducedKey] = reducedInstr;
		}
		return reducedInstr;
	}

	def addPhi(phi: SsaPhi, cur: SsaInstr) {
		def key: OptMapKey = instrToOptMapKey(phi);
		optMap[key] = cur;
	}

	def throwOptInstrNotFound(i: SsaInstr) {
		def msg = Strings.format1("Instruction %d not found in block context\n", i.uid);
		System.error("PartialEvaluationFailedException", msg);
	}
	/**
	 * Mapping function over the list of dfEdges for an instruction.
	 */
	private def dfEdgeToInstr(dfEdge: SsaDfEdge) -> SsaInstr {
		if (SsaConst.?(dfEdge.dest)) return dfEdge.dest;
		if (!hasOptInstr(dfEdge.dest)) {
			Terminal.put2("\tInstr %d with key (%q) not found in map\n", dfEdge.dest.uid, instrToOptMapKey(dfEdge.dest).render);
			return dfEdge.dest;
		}
		def resultInstr = getOptInstr(dfEdge.dest);
		if (resultInstr == null) throwOptInstrNotFound(dfEdge.dest);
		return resultInstr;
	}

	def hasOptInstr(i: SsaInstr) -> bool {
		def key = instrToOptMapKey(i);
		return optMap.has(key);
	}

	def getOptInstr(i: SsaInstr) -> SsaInstr {
		Terminal.put1("getOptInstr uid: %d\n", i.uid);
		if (SsaConst.?(i)) return i;
		var instr = i;
		if (SsaApplyOp.?(i)) {
			instr = optimizeArgs(SsaApplyOp.!(i));
		}
		def key = instrToOptMapKey(instr);
		Terminal.put1("\tkey: (%q)\n", key.render);
		if (!optMap.has(key)) return null;
		return optMap[key];
	}
}

