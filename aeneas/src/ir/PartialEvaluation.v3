/**
 * Defines a partial evaluator where given a set of inputs, 
 * the partial evaluator will evaluate as much of the program 
 * as it can. The partial evaluator should output a specialized 
 * version of the program. 
 */
class PartialEvaluator {
	// ----------------- Constants -----------------
	def DEBUG = true;
	def DEBUG_CTX = false;
	def DEBUG_INSTR = false;
	// ----------------- Helpers -----------------
	def blockOrder: SsaBlockOrder;
	def instrReducer: SsaInstrReducer;
	var worklist: List<SsaBlock>;
	var nextBlock: SsaBlock;
	def blockContextsMap = Ssa.newBlockMap<List<PEBlockContext>>();
	def headerToLoop = Ssa.newBlockMap<SsaLoopInfo>();
	var loopStack: List<LoopIterInfo>;
	def printer = SsaPrinter.new();
	var buf: TerminalBuffer;

	new (blockOrder, instrReducer) {
		// Construct SRPO 
		blockOrder.computeDominators();
		// Construct header to loop map for loop identification later
		def allLoopInfo: Vector<SsaLoopInfo> = blockOrder.loops;
		if (allLoopInfo != null) {
			for (i = 0; i < allLoopInfo.length; i++) {
				def loopInfo = allLoopInfo[i];
				def header: SsaBlock = blockOrder.order[loopInfo.start];
				headerToLoop[header] = loopInfo;
			}
		}
		buf = printer.buf;
	}

	def evaluate() { 
		def ordering: Vector<SsaBlock> = blockOrder.order;
		if (ordering.length == 0) return;
		nextBlock = ordering[0];
		while (nextBlock != null) evalSsaBlock();
		if (DEBUG) Terminal.put("Finished partial evaluation\n\n");
	}

	/**
	 * Returns the most recent context created for a block
	 */
	def getLatestBlockContext(block: SsaBlock) -> PEBlockContext {
		if (!blockContextsMap.has(block)) return null;
		def contextList = blockContextsMap[block];
		return if (contextList == null, null, contextList.head);
	}

	/**
	 * Adds a new block context for the block
	 */
	def addNewBlockContextToMap(block: SsaBlock, newContext: PEBlockContext) {
		def oldContextList = blockContextsMap[block];
		blockContextsMap[block] = List.new(newContext, oldContextList);
	}	

	/**
	 * Checks whether the current block is a header block of a 
	 * loop that hasn't been evaluated yet. 
	 */
	def isHeaderOfNewLoop(block: SsaBlock) -> bool {
		return (loopStack != null && 
			!loopStack.head.hasLoopEvalStarted && 
			headerToLoop.has(block));
	}

	/**
	 * Updates the loop stack by popping off stale loops. 
	 */
	def popStaleLoopsFromStack(block: SsaBlock) {
		var curIterInfo: LoopIterInfo = loopStack.head;
		var curLoopInfo: SsaLoopInfo = curIterInfo.info;
		def isInLoop = blockOrder.isInLoop(block, _);
		while (loopStack != null && !isInLoop(curLoopInfo.index)) {
			loopStack = loopStack.tail;
			if (loopStack != null) {
				curLoopInfo = loopStack.head.info;
			}
		}
	}

	/**
	 * Uses the current block to determine whether or not we have 
	 * left the current loop or entered a new loop.
	 */
	def updateLoopStack(block: SsaBlock) {
		// Check if block is the current loop's header
		if (loopStack != null && headerToLoop.has(block)) {
			def loopInfo = headerToLoop[block];
			if (loopStack.head.info == loopInfo) return;
		}
		if (loopStack != null) popStaleLoopsFromStack(block);
		// Non-header blocks cannot start new loop or iteration
		if (!headerToLoop.has(block)) return;

		// New loop
		def curLoopInfo: SsaLoopInfo = headerToLoop[block];
		def iterInfo = LoopIterInfo.new(curLoopInfo);
		loopStack = List.new(iterInfo, loopStack);
		return;
	}

	def isMergeBlockPred(block: SsaBlock) -> bool {
		def end = block.end();
		if (!SsaGoto.?(end)) return false;
		def goto = SsaGoto.!(end);
		return goto.target().preds.length > 1;
	}

	/**
	 * Checks whether all intructions in the vector are the same.
	 */
	def areInstrsConstant(instrVec: Vector<SsaInstr>) -> bool {
		def first = instrVec[0];
		for (i = 1; i < instrVec.length; i++) {
			if (first != instrVec[i]) return false;
		}
		return true;
	}

	/**
	 * Receives the optimized input to a phi function, given the 
	 * phi and the block it resides in.
	 */
	def getOptPhiInput(
		phi: SsaPhi, 
		block: SsaBlock, 
		predIdx: int
	) -> SsaInstr {
		def predBlock = block.preds[predIdx].src.block();
		def predContext = getLatestBlockContext(predBlock);
		def arg = phi.inputs[predIdx].dest;
		def optArg: SsaInstr = predContext.getOptInstr(arg);
		return optArg;
	}

	def printConst(iConst: SsaConst, buf: StringBuilder) -> StringBuilder {
		match (iConst.getType()) {
			x: IntType => {
				   def ival = Int.unbox(iConst.val);
				   buf.put1(" (val=%d)", ival);
			   }
			x: BoolType => {
				   def bval = Bool.unbox(iConst.val);
				   buf.put1(" (val=%z)", bval);
			   }
		}
		return buf;
	}

	/**
	 * Evaluate SsaPhi in non-loop header 
	 */
	def evalSsaPhi(
		phi: SsaPhi, 
		block: SsaBlock, 
		blockContext: PEBlockContext
	) {
		// SsaPhi represents a loop variable
		if (isHeaderOfNewLoop(block)) {
			// Take the first input to phi if loop not started
			// TODO: there can be multiple non loop predecessors
			def optArg = getOptPhiInput(phi, block, 0);
			blockContext.addPhi(phi, optArg);
			return;
		}
		// NOTE: need to consider predecessor contexts because
		// context merging could have left out phi input instrs

		def numInputs = phi.inputs.length;
		def cfToPred = (fun (cf: SsaCfEdge) => cf.src.block());
		def predBlocks = Arrays.map(block.preds, cfToPred);
		def predContexts = Arrays.map(predBlocks, getLatestBlockContext);
		def liveInputs = Vector<SsaInstr>.new();

		// If block is loop header and loop in progress, skip 0th pred
		def startIdx = if (headerToLoop.has(block), 1, 0);
		// If predecessor block wasn't traversed, skip
		for (i = startIdx; i < numInputs; i++) {
			if (!predContexts[i].live) continue;
			def optArg = getOptPhiInput(phi, block, i);
			liveInputs.put(optArg);
		}
		if (liveInputs.length == 0) throwNoLivePredsFound(block);
		// Check if all inputs end up being the same
		if (areInstrsConstant(liveInputs)) {
			blockContext.addPhi(phi, liveInputs[0]);
			return;
		}
		// No simplifications possible
		blockContext.addPhi(phi, phi); 
		// TODO: If not constant, try to extract facts
	}


	/** 
	 * Evaluate SsaGoto
	 */
	def evalSsaGoto(goto: SsaGoto) {
		def target: SsaBlock = goto.target();
		def curBlock: SsaBlock = goto.block();
		// Loop traversal logic
		def inHeaderLoop = loopStack != null && loopStack.head.info.start == target.info.srpo_num;
		def isBackedge = headerToLoop.has(target) && inHeaderLoop;
		if (isBackedge) {
			def targetContext = getLatestBlockContext(target);
			def isLoopLive = targetContext.live;
			if (isLoopLive) {
				nextBlock = target;
				return;
			}
			// If loop is dead, follow SRPO
		}
		// Non-loop logic or dead loop 
		nextBlock = blockOrder.order[curBlock.info.srpo_num + 1];
	}

	/**
	 * Evaluate SsaIf
	 */
	def evalSsaIf(ifStmt: SsaIf, blockContext: PEBlockContext) {
		// Loop guard
		if (headerToLoop.has(ifStmt.block()))  {
			if (blockContext.live) {
				loopStack.head.hasLoopEvalStarted = true;
				def cond = blockContext.getOptInstr(ifStmt.input0());
				if (SsaConst.?(cond)) {
					def rawCond = Bool.unbox(SsaConst.!(cond).val);
					if (rawCond) nextBlock = ifStmt.trueBlock();
					else nextBlock = ifStmt.falseBlock();
					return;
				}
			} else  {
				def curLoop = loopStack.head;
				// If the loop is dead, we evaluate it once
				// to propagate info on which blocks are dead
				if (curLoop.hasLoopEvalStarted) {
					nextBlock = ifStmt.falseBlock();
				} else {
					curLoop.hasLoopEvalStarted = true;
					nextBlock = ifStmt.trueBlock();
				}
				return;
			}
		}

		// Follow the SRPO ordering
		nextBlock = ifStmt.trueBlock();
		if (headerToLoop.has(ifStmt.block())) {
			loopStack.head.hasLoopEvalStarted = true;
		}
	}

	/**
	 * Evaluate SsaSwitch
	 */
	def evalSsaSwitch(switch: SsaSwitch) {
		nextBlock = blockOrder.order[switch.block().info.srpo_num + 1];
	}

	def putBlock(block: SsaBlock) {
		printer.indent(Lists.length(loopStack));
		buf.puts("block ").putBlock(block);
		// Print out predecessors and their liveness status
		if (headerToLoop.has(block) && !loopStack.head.hasLoopEvalStarted) {
			def predBlock = block.preds[0].src.block();
			def isLive = getLatestBlockContext(predBlock).live;
			// Only preheader matters here
			// Other predecessors treated as dead
			def status = if(isLive, "live", "dead");
			buf.putc(' ').putLink(predBlock.end()).put1("=%s", status);
			for (i = 1; i < block.preds.length; i++) {
				buf.putc(' ').putLink(block.preds[i].src).puts("=dead");
			}
			buf.ln();
			buf.outt();
			return;
		}
		// Consider all predecessors
		for (i = 0; i < block.preds.length; i++) {
			def predBlock = block.preds[i].src.block();
			def isLive = getLatestBlockContext(predBlock).live;
			def status = if(isLive, "live", "dead");
			buf.putc(' ').putLink(block.preds[i].src).put1("=%s", status);
		}
		buf.ln();
		buf.outt();
	}

	def putInstr(instr: SsaInstr, blockContext: PEBlockContext) {
		if (!DEBUG_INSTR) return;
		match (instr) {
			x: SsaPhi,
			x: SsaApplyOp => {
				printer.indent(Lists.length(loopStack));
				def optInstr = blockContext.getOptInstr(instr);
				printer.printInstr(instr, true, true, false, false);
				buf.puts(" becomes ");
				printer.printInstr(optInstr, true, true, false, false);
			   }
			x: SsaEnd => {
				// Subtract 2 because print end auto-adds 2 indents
				printer.indent(Lists.length(loopStack) - 2);
				printer.printEnd(x.block(), x);
			   }
		}
		buf.ln();
		buf.outt();
	}
	
	/**
	 * Evaluate the next block
	 */
	def evalSsaBlock() {
		def block: SsaBlock = nextBlock;
		updateLoopStack(block);

		// TODO: identifiers for reusing contexts
		def curLoop = if(loopStack == null, null, loopStack.head);
		def blockContext = PEBlockContext.new(block, getLatestBlockContext, curLoop);
		addNewBlockContextToMap(block, blockContext);

		if (DEBUG) putBlock(block);

		// Skip to the end if the context is dead
		if (!blockContext.live) {
			evalSsaEnd(block.end(), blockContext);
			if (DEBUG) blockContext.printContext(Lists.length(loopStack), printer, DEBUG_CTX);
			return;
		}

		for (link = block.next; link != block; link = link.next) {
			match (link) {
				x: SsaApplyOp => blockContext.addApplyOp(x, instrReducer);
				x: SsaPhi => evalSsaPhi(x, block, blockContext);
				x: SsaEnd => evalSsaEnd(x, blockContext); 
			}
			if (DEBUG && SsaInstr.?(link)) putInstr(SsaInstr.!(link), blockContext);
		}
		if (DEBUG) blockContext.printContext(Lists.length(loopStack), printer, DEBUG_CTX);
		def ordering = blockOrder.order;
		if (block == ordering[ordering.length - 1]) nextBlock = null;
		return;
	}

	// Returns the SRPO index to resume partial evaluation at 
	def evalSsaEnd(end: SsaEnd, blockContext: PEBlockContext) {
		// Partial evaluator is called after switches have been lowered to if statements 
		match (end) {
			x: SsaReturn, 
			x: SsaThrow => return; // TODO: how do we know when to end
			x: SsaIf => evalSsaIf(x, blockContext);
			x: SsaGoto => evalSsaGoto(x);
			x: SsaSwitch => evalSsaSwitch(x);
			_ => return;
		}
	}

	def throwNoLivePredsFound(block: SsaBlock) {
		def msg = Strings.format1("Expected traversal of predecessors before merge block %d.\n", block.uid);
		System.error("PartialEvaluatorException", msg);
	}

	def throwOptInstrNotFound(i: SsaInstr) {
		def msg = Strings.format1("Instruction %d not found in block context\n", i.uid);
		System.error("PartialEvaluationFailedException", msg);
	}

	def throwNoContextsFound(block: SsaBlock) {
		def msg = Strings.format1("Block %d has no context", block.uid);
		System.error("PartialEvaluationException", msg);
	}
}

/**
 * Used to track information about the current iteration of the loop
 * the partial evaluator is in. Tracks the merge blocks that we will 
 * traverse and the predecessors that have been traversed in this iteration.
 */
class LoopIterInfo (info: SsaLoopInfo) {
	var hasLoopEvalStarted = false;
}

type OptMapKey(instr: SsaInstr, inputs: Array<SsaInstr>) {
	/**
	 * Implicitly takes as input an additional OptMapKey when called
	 * off of the type identifier
	 */
	def hash() -> int {
		var hashResult: int = 0;
		match (instr) {
			x: SsaApplyOp => {
				hashResult = x.op.opcode.tag;
			   }
			x: SsaPhi => {
				// There are much less opcodes than this
				hashResult = 300;
			   }
			x: SsaParam => {
				hashResult = 301;
			   }
			_ => {
				def msg = Strings.format1("Unsupported instruction type for instr: %d.\n", instr.uid);
				System.error("PartialEvaluationException", msg);
				return -1;
			}
		}
		for (i in inputs) hashResult = hashResult * 33 + i.uid;
		return hashResult;
	}

	/**
	 * Implicitly takes as input an OptMapKey additional when called
	 * off of the type identifier
	 */
	def equals(that: OptMapKey) -> bool {
		match (that.instr) {
			x: SsaApplyOp => {
				if (!SsaApplyOp.?(this.instr)) return false;
				if (x.op != SsaApplyOp.!(this.instr).op) return false;
				// TODO: take care of commutative operations
				return  Arrays.allTrue(this.inputs, that.inputs, SsaInstr.==);
			   }
			x: SsaParam,
			x: SsaPhi => return this.instr == that.instr;
			_ => return false;
		}
	}

	def printConst(iConst: SsaConst, buf: StringBuilder) -> StringBuilder {
		match (iConst.getType()) {
			x: IntType => {
				   def ival = Int.unbox(iConst.val);
				   buf.put1(" (val=%d)", ival);
			   }
			x: BoolType => {
				   def bval = Bool.unbox(iConst.val);
				   buf.put1(" (val=%z)", bval);
			   }
		}
		return buf;
	}

	def render(buf: StringBuilder) -> StringBuilder {
		match (instr) {
			x: SsaApplyOp => {
				x.op.render(buf);
				buf.puts(" | ");
			   }
			x: SsaPhi => {
				buf.put1("Phi %d | ", x.uid);
			   }
			x: SsaParam => {
				buf.put1("Param %d | ", x.uid);
			   }

		}
		for (i = 0; i < inputs.length; i++) {
			def instr = inputs[i];
			buf.put1("uid: %d", instr.uid);
			if (SsaConst.?(instr)) printConst(SsaConst.!(instr), buf);
			if (i != (inputs.length - 1)) buf.puts(" | ");
		}
		return buf;
	}
}

// PE stands for "Partial Evaluation"
/**
 * Why keep optimization info map for each context? 
 * Alternative: specialize the code
 * MVP: ensure traversal is correct
 * Afterward, it's possible we already have a specialization 
 * we want to continue using. Instead of overspecializing, 
 * it's possible we instead want to assume something is 
 * constant for evaluating but assume different things
 * are constant when specializing
 *
 * How do you use the map: replace all usages with the 
 * instruction we map to.
 *
 * Conventions:
 * If the context is dead, then predContexts is null.
 * If the context is live, then predContexts is non-null. Note that 
 * predContexts can be empty, particularly for the case of the root context
 */
class PEBlockContext {
	var predContexts: Array<PEBlockContext>;
	var optMap = HashMap<OptMapKey, SsaInstr>.new(OptMapKey.hash, OptMapKey.equals);
	var live = false;
	def block: SsaBlock;
	new(block, blockToContext: SsaBlock -> PEBlockContext, curLoop: LoopIterInfo) { 
		def cfEdgeToBlock = (fun (cf: SsaCfEdge) => cf.src.block());
		def predBlocks = Arrays.map(block.preds, cfEdgeToBlock);
		// Case on whether the context starts a loop context
		def isCurLoopHeader = curLoop != null && (curLoop.info.start == block.info.srpo_num);
		if (startsDeadBranch(blockToContext)) {
			createDeadContext();
		} else if (isCurLoopHeader) {
			createLoopHeaderContext(predBlocks, blockToContext, curLoop);
		} else {
			createNonLoopHeaderContext(predBlocks, blockToContext, curLoop);
		}
	}

	/**
	 * Creates a dead context.
	 * 
	 * Not tracking predecessors for dead contexts because
	 * it's a waste of memory. For live contexts, tracking dead
	 * contexts would make optimized instruction lookup more inefficient.
	 */
	def createDeadContext() {
		predContexts = null;
		live = false;
	}

	/**
	 * Creates a context for a loop header block.
	 * 
	 * If the first iteration of the loop hasn't been
	 * partially evaluated yet, then only consider the live
	 * non-loop predecessors. This case includes the situation where 
	 * a loop has been previously evaluated and the partial evaluator
	 * is entering it once more. 
	 * 
	 * Otherwise, if the loop is being partially evaluated, then 
	 * only consider the live backedge-source predecessors.
	 */
	def createLoopHeaderContext(
		predBlocks: Array<SsaBlock>,
		blockToContext: SsaBlock -> PEBlockContext, 
		curLoop: LoopIterInfo
	) {
		var allContexts: Array<PEBlockContext>;
		if (!curLoop.hasLoopEvalStarted) {
			// Take only predecessors not in the loop
			def notInLoop = (fun (b: SsaBlock) => !curLoop.info.contains(b));
			def nonLoopPreds = Arrays.filter(predBlocks, notInLoop);
			allContexts = Arrays.map(nonLoopPreds, blockToContext);
		} else {
			// Take only predecessors in the loop
			def backedgePreds = Arrays.filter(predBlocks, curLoop.info.contains);
			allContexts = Arrays.map(backedgePreds, blockToContext);
		}
		def liveContexts = Arrays.filter(allContexts, PEBlockContext.live);
		mergeContexts(liveContexts);
		live = predContexts != null;
	}

	/**
	 * Creates a context for a block that isn't a loop header.
	 */
	def createNonLoopHeaderContext(
		predBlocks: Array<SsaBlock>,
		blockToContext: SsaBlock -> PEBlockContext, 
		curLoop: LoopIterInfo
	) {
		if (predBlocks.length == 0) {
			// root context
			predContexts = [];
			live = true;
			return;
		}
		def allContexts = Arrays.map(predBlocks, blockToContext);
		def liveContexts = Arrays.filter(allContexts, PEBlockContext.live);
		mergeContexts(liveContexts);
		live = liveContexts.length > 0;
	}

	/**
	 * Checks if the first block on a branch is part of a dead branch
	 * or a live branch.
	 */
	def startsDeadBranch(blockToContext: SsaBlock -> PEBlockContext) -> bool {
		if (block.preds.length != 1) return false;
		def predEnd = block.preds[0].src;
		match (predEnd) {
			ifStmt: SsaIf => {
				// Check the condition
				def origCond = predEnd.input0();
				def predContext = blockToContext(predEnd.block());
				def cond = predContext.getOptInstr(origCond);

				if (!SsaConst.?(cond)) return false;
				def rawCond = Bool.unbox(SsaConst.!(cond).val);
				if ((rawCond && block == ifStmt.trueBlock()) ||
				    (!rawCond && block == ifStmt.falseBlock())) {
					return false;
				}
				return true;
			}
			switchStmt: SsaSwitch => {
				// Check the condition
				def origCond = predEnd.input0();
				def predContext = blockToContext(predEnd.block());
				def cond = predContext.getOptInstr(origCond);

				if (!SsaConst.?(cond)) return false;
				def constCond = SsaConst.!(cond);
				def liveCf = switchStmt.findSucc(constCond.val);
				// Dead branch is one that doesn't match live control flow 
				return liveCf.dest != block;
			}
			_ => {
				return false;
			}
		}
	}


	/**
	 * Merges information across predecessor contexts if there are 
	 * multiple predecessors. Otherwise, noop.
	 *
	 * Requires the input array of predecessor contexts to all be 
	 * live contexts.
	 */
	def mergeContexts(liveContexts: Array<PEBlockContext>) {
		if (liveContexts.length == 0) {
			predContexts = null;
			return;
		}
		predContexts = liveContexts;
		if (predContexts.length == 1) return;

		// merge optimization maps
		optMap = predContexts[0].optMap;
		for (i = 1; i < predContexts.length; i++) {
			def context = predContexts[i];
			optMap = Maps.intersect(optMap, context.optMap);
		}
	}

	def printConst(iConst: SsaConst, buf: StringBuilder) -> StringBuilder {
		match (iConst.getType()) {
			x: IntType => {
				   def ival = Int.unbox(iConst.val);
				   buf.put1(" (val=%d)", ival);
			   }
			x: BoolType => {
				   def bval = Bool.unbox(iConst.val);
				   buf.put1(" (val=%z)", bval);
			   }
		}
		return buf;
	}

	def printContext(numIndents: int, printer: SsaPrinter, DEBUG_CTX: bool) {
		if (!DEBUG_CTX) return;
		def buf = printer.buf;
		for (i < numIndents) buf.putc('\t');
		buf.yellow().puts("Context {").end().ln();
		def keyList: List<OptMapKey> = Maps.keyList(optMap);
		for (l = keyList; l != null; l = l.tail) {
			def key = l.head;
			for (i < numIndents + 1) buf.putc('\t');
			buf.put1("(%q) -> ", key.render);
			printer.printInstr(optMap[key], false, false, false, false);
			buf.ln();
		}
		for (i < numIndents + 1) buf.putc('\t');
		buf.green().put1("live block: %z\n", live).end();
		for (i < numIndents) buf.putc('\t');
		buf.yellow().puts("}").end();
		buf.ln();
		buf.ln();
		buf.outt();
	}
	
	def instrToOptMapKey(instr: SsaInstr) -> OptMapKey {
		def dfEdges = instr.inputs;
		def args = Arrays.map(dfEdges, SsaDfEdge.dest);
		// TODO: Only need to pass in instruction
		// Need entire instruction for phi case
		// Apply op case onlyneeds args
		return OptMapKey(instr, args);
	}

	/**
	 * Prints an array of instructions
	 */
	def printArgs(args: Array<SsaInstr>) {
		Terminal.put("\targs: ");
		for (a in args) Terminal.put1("%d ", a.uid);
		Terminal.put("\n");
	}

	/** 
	 * Returns the instruction with the optimized version of 
	 * each argument. 
	 */
	def optimizeArgs(i: SsaApplyOp) -> SsaApplyOp {
		def newArgs = Arrays.map(i.inputs, dfEdgeToInstr);
		// TODO: transfer facts
		return SsaApplyOp.new(i.source, i.op, newArgs);
	}

	/**
	 * Adds an SsaApplyOp operation to the optimization map
	 */
	def addApplyOp(i: SsaApplyOp, instrReducer: SsaInstrReducer) -> SsaInstr {
		def origKey: OptMapKey = instrToOptMapKey(i);
		// Check if instr is already in map
		if (optMap.has(origKey)) return optMap[origKey];
		// Optimize args and update map
		def iWithOptArgs = optimizeArgs(i);
		def reducedInstr = instrReducer.reduceApplyOp(iWithOptArgs);
		def optArgsKey: OptMapKey = instrToOptMapKey(iWithOptArgs);
		// Update map with instruction -> optimize instruction pairings
		// to increase chance of opt map hits
		optMap[origKey] = reducedInstr;
		return reducedInstr;
	}

	def addPhi(phi: SsaPhi, cur: SsaInstr) {
		def key: OptMapKey = instrToOptMapKey(phi);	
		optMap[key] = cur;
	}

	def throwOptInstrNotFound(i: SsaInstr) {
		def msg = Strings.format1("Instruction %d not found in block context\n", i.uid);
		System.error("PartialEvaluationFailedException", msg);
		// TODO: Modify SsaContext
		// shouldn't be system.error
	}
	/**
	 * Mapping function over the list of dfEdges for an instruction.
	 */
	private def dfEdgeToInstr(dfEdge: SsaDfEdge) -> SsaInstr {
		if (SsaConst.?(dfEdge.dest)) return dfEdge.dest;
		if (!hasOptInstr(dfEdge.dest)) {
			Terminal.put2("\tInstr %d with key (%q) not found in map\n", dfEdge.dest.uid, instrToOptMapKey(dfEdge.dest).render);
			return dfEdge.dest;
		}
		def resultInstr = getOptInstr(dfEdge.dest);
		if (resultInstr == null) throwOptInstrNotFound(dfEdge.dest);
		return resultInstr;
	}

	def hasOptInstr(i: SsaInstr) -> bool {
		return getOptInstr(i) != null;
	}

	def getOptInstr(i: SsaInstr) -> SsaInstr {
		if (!live) return null;
		if (SsaConst.?(i)) return i;
		def key = instrToOptMapKey(i);
		var curOptMap = optMap;
		var curContext: PEBlockContext = this;
		while (!curOptMap.has(key)) {
			if (curContext.predContexts.length != 1) return null;
			curContext = curContext.predContexts[0];
			curOptMap = curContext.optMap;
		}
		return curOptMap[key];
	}
}

