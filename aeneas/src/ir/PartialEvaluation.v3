/**
 * Defines a partial evaluator where given a set of inputs, 
 * the partial evaluator will evaluate as much of the program 
 * as it can. The partial evaluator should output a specialized 
 * version of the program. 
 */
class PartialEvaluator {
	// ----------------- Constants -----------------
	def DEBUG = true;
	// ----------------- Helpers -----------------
	def blockOrder: SsaBlockOrder;
	def instrReducer: SsaInstrReducer;
	var worklist: List<SsaBlock>;
	def blockContextsMap = Ssa.newBlockMap<List<PEBlockContext>>();
	def headerToLoop = Ssa.newBlockMap<SsaLoopInfo>();
	var loopStack: List<LoopIterInfo>;

	new (blockOrder, instrReducer) {
		// Construct SRPO 
		blockOrder.computeDominators();
		// Construct header to loop map for loop identification later
		def allLoopInfo: Vector<SsaLoopInfo> = blockOrder.loops;
		if (allLoopInfo != null) {
			for (i = 0; i < allLoopInfo.length; i++) {
				def loopInfo = allLoopInfo[i];
				def header: SsaBlock = blockOrder.order[loopInfo.start];
				headerToLoop[header] = loopInfo;
			}
		}
	}

	def evaluate() { 
		def ordering: Vector<SsaBlock> = blockOrder.order;
		if (ordering.length == 0) return;
		worklist = Lists.cons1<SsaBlock>(ordering[0]);
		while (worklist != null) evalSsaBlock();
	}

	/**
	 * Returns the most recent context created for a block
	 */
	def getLatestBlockContext(block: SsaBlock) -> PEBlockContext {
		if (!blockContextsMap.has(block)) return null;
		def contextList = blockContextsMap[block];
		return if (contextList == null, null, contextList.head);
	}

	/**
	 * Adds a new block context for the block
	 */
	def addNewBlockContextToMap(block: SsaBlock, newContext: PEBlockContext) {
		def oldContextList = blockContextsMap[block];
		blockContextsMap[block] = List.new(newContext, oldContextList);
	}

	def intersect(
		m1: PartialMap<OptMapKey, SsaInstr>, 
		m2: PartialMap<OptMapKey, SsaInstr>
	) -> PartialMap<OptMapKey, SsaInstr> {
		def keys1 = Maps.keyList(m1);
		def keys2 = Maps.keyList(m2);
		if (keys1 == null) return m2;
		if (keys2 == null) return m1;
		def keys = if(Lists.length(keys1) < Lists.length(keys2), keys1, keys2);
		def newMap = HashMap<OptMapKey, SsaInstr>.new(OptMapKey.hash, OptMapKey.equals);
		for (l = keys; l != null; l = l.tail) {
			def k = l.head;
			def bothHaveKey = m1.has(k) && m2.has(k);
			if (!bothHaveKey) continue;
			def m1Val = m1[k];
			def m2Val = m2[k];
			var sameInstr = m1Val == m2Val;
			if (SsaApplyOp.?(m1Val) && SsaApplyOp.?(m2Val)) {
				// Already know inputs and operator are the 
				// same because OptMapKey is the same
				sameInstr = true;
			}
			if (!sameInstr) continue;
			newMap[k] = m1Val;
		}

		return newMap;
	}

	def mergeContexts(preds: Array<SsaBlock>) -> PEBlockContext {
		if (preds.length == 0) return null;
		def predContext = getLatestBlockContext(preds[0]);
		if (predContext == null) throwNoContextsFound(preds[0]);
		if (preds.length == 1) {
			return PEBlockContext.new(predContext);
		}
		var resultMap: PartialMap<OptMapKey, SsaInstr> = predContext.optMap;

		for (i = 1; i < preds.length; i++) {
			def context = getLatestBlockContext(preds[i]);
			if (context == null) throwNoContextsFound(preds[i]);
			resultMap = intersect(resultMap, context.optMap);
		}
		def mergedContext = PEBlockContext.new(null);
		mergedContext.optMap = HashMap<OptMapKey, SsaInstr>.!(resultMap);
		return mergedContext;
	}



	/**
	 * Creates a block context for the block given information about it.
	 */
	def createContextForBlock(block: SsaBlock) -> PEBlockContext {
		if (DEBUG) Terminal.put1("Created context for block %d.\n", block.uid);
		if (block.preds.length == 0) {
			// Base case: Start block in CFG
			Terminal.put("\tRoot context case.\n");
			def newContext = PEBlockContext.new(null);
			addNewBlockContextToMap(block, newContext);
			return newContext;
		} else if (block.preds.length > 1) {
			// Merge block
			def cfToBlock = fun (cf: SsaCfEdge) => cf.src.block();
			def allPredBlocks = Arrays.map<SsaCfEdge, SsaBlock>(block.preds, cfToBlock);
			if (loopStack == null) {
				// No loops. Refer to blockContextsMap for live preds
				Terminal.put("\tNot loop merge block\n");
				def cond = fun (b: SsaBlock) => blockContextsMap.has(b);
				def livePreds = Arrays.filter(allPredBlocks, cond);
				if (livePreds.length == 0) throwNoLivePredsFound(block);
				def mergedContext = mergeContexts(livePreds);
				addNewBlockContextToMap(block, mergedContext);
				return mergedContext;
			} 
			// Currently in loop. Refer to mergeBlockMap for live preds
			Terminal.put("\tLoop merge block\n");
			def livePreds = loopStack.head.getLivePreds(block);
			if (livePreds.length == 0) {
				// Loop body untraversed. Entering loop
				def loopEntrance = block.preds[0].src.block();
				if (!blockContextsMap.has(loopEntrance)) throwNoLivePredsFound(block);
				def predContext = getLatestBlockContext(loopEntrance);
				def newContext = PEBlockContext.new(predContext);
				addNewBlockContextToMap(block, newContext);
				return newContext;

			}
			// Loop body traversed
			def mergedContext = mergeContexts(livePreds);
			addNewBlockContextToMap(block, mergedContext);
			return mergedContext;
		}
		// Build context off of sole predecessor
		def cfEdge: SsaCfEdge = block.preds[0];
		def pred: SsaBlock = cfEdge.src.block();
		def lastPredContext = getLatestBlockContext(pred);
		if (lastPredContext == null) throwNoContextsFound(pred);
		def newContext = PEBlockContext.new(lastPredContext);
		addNewBlockContextToMap(block, newContext);
		return newContext;
	}

	/**
	 * Uses the current block to determine whether or not we have 
	 * left the current loop or entered a new loop.
	 */
	def updateLoopStack(block: SsaBlock) {
		if (loopStack != null) {
			// Handle breaks and new outer loop iterations
			var curIterInfo: LoopIterInfo = loopStack.head;
			var curLoopInfo: SsaLoopInfo = curIterInfo.info;
			while (loopStack != null && !blockOrder.isInLoop(block, curLoopInfo.index)) {
				loopStack = loopStack.tail;
				curLoopInfo = if (loopStack != null, loopStack.head.info, curLoopInfo);
			}
		}

		// Non-header blocks cannot start new loop or iteration
		if (!headerToLoop.has(block)) return;

		// Handle new loop iteration vs new loop traversal

		def loopForHeader: SsaLoopInfo = headerToLoop[block];
		if (loopStack == null) {
			// Base case: New loop
			def iterInfo = LoopIterInfo.new(loopForHeader);
			loopStack = Lists.cons1(iterInfo);
			return;
		}

		// New iteration
		if (loopStack.head.info == loopForHeader) {
			loopStack.head.newMergeBlockMap();
			return;
		} 
		// New loop
		def curLoopInfo: SsaLoopInfo = headerToLoop[block];
		def iterInfo = LoopIterInfo.new(curLoopInfo);
		loopStack = List.new(iterInfo, loopStack);
		return;
	}

	def isMergeBlockPred(block: SsaBlock) -> bool {
		def end = block.end();
		if (!SsaGoto.?(end)) return false;
		def goto = SsaGoto.!(end);
		return goto.target().preds.length > 1;
	}

	def updateMergeBlockMap(block: SsaBlock) {
		def goto = SsaGoto.!(block.end());
		def mergeBlock = goto.target();
		def iterInfo = loopStack.head;
		var predList = iterInfo.mergeBlockMap[mergeBlock];
		predList = List.new(block, predList);
		iterInfo.mergeBlockMap[mergeBlock] = predList;
	}


	
	/**
	 * Evaluate the next block in the worklist. 
	 */
	def evalSsaBlock() {
		if (worklist == null) return;
		def block: SsaBlock = worklist.head;
		updateLoopStack(block);
		if (isMergeBlockPred(block) && loopStack != null) {
			updateMergeBlockMap(block);
		}
		// TODO: identifiers for reusing contexts
		def blockContext = createContextForBlock(block);
		worklist = worklist.tail;
		if (DEBUG) Terminal.put1("Eval block uid: %d\n", block.uid);
		for (instr = block.next; instr != block; instr = instr.next) {
			match (instr) {
				x: SsaApplyOp => {
					// Reconstruct instruction (to avoid modifying original)
					blockContext.addApplyOp(x, instrReducer);
				   } // Call on the SsaInstrReducer 
				x: SsaPhi => {
					def isLoopHeader = headerToLoop.has(block);
					if (!isLoopHeader) continue; //TODO: merge blocks
					def backedge: SsaCfEdge = block.preds[1];
					def isInLoop = getLatestBlockContext(backedge.src.block()) != null;
					if (!isInLoop) {
						// Get optimized instruction from preheader
						if (DEBUG) Terminal.put("\tLoop body not traversed yet\n");
						def preheader: SsaBlock = block.preds[0].src.block();
						def preheaderContext = getLatestBlockContext(preheader);
						if (preheaderContext == null) throwNoContextsFound(preheader);
						def origPhiInput: SsaInstr = x.inputs[0].dest;
						def optPhiInput: SsaInstr = preheaderContext.getOptInstr(origPhiInput);
						if (optPhiInput == null) throwOptInstrNotFound(origPhiInput);
						if (DEBUG) {
							Terminal.put2("Entering loop. Phi %d with input %d.\n", x.uid, optPhiInput.uid);
						}
						blockContext.addPhi(x, optPhiInput);
						continue;
					}
					// Get optimized instruction from updateBlock
					def updateBlock: SsaBlock = block.preds[1].src.block();
					def updateContext = getLatestBlockContext(updateBlock);
					Terminal.put1("Update context:\n%q\n", updateContext.render);
					if (updateContext == null) throwNoContextsFound(updateBlock);
					def origPhiInput: SsaInstr = x.inputs[1].dest;
					def optPhiInput: SsaInstr = updateContext.getOptInstr(origPhiInput);
					if (DEBUG) {
						Terminal.put2("\tIs opt phi input %d const: %z\n", optPhiInput.uid, SsaConst.?(optPhiInput));
						if (SsaConst.?(optPhiInput)) {
							Terminal.put1("\tConst instr with val: %d\n", Int.unbox(SsaConst.!(optPhiInput).val));
						}
					}
					if (optPhiInput == null) throwOptInstrNotFound(origPhiInput);
					blockContext.addPhi(x, optPhiInput);

				   }
				x: SsaEnd => return evalSsaEnd(x, blockContext); 
			}
		}
		if (DEBUG) Terminal.put1("SsaBlock uid %d missing SsaEnd\n", block.uid);
		return;
	}

	// Returns the SRPO index to resume partial evaluation at 
	def evalSsaEnd(end: SsaEnd, blockContext: PEBlockContext) {
		// Partial evaluator is called after switches have been lowered to if statements
		match (end) {
			x: SsaReturn, 
			x: SsaThrow => return; // TODO: how do we know when to end
			x: SsaIf => {
				if (DEBUG) Terminal.put1("SsaIf uid: %d\n", x.uid);
				// Case on whether the condition is variable or constant
				var condInstr = x.input0();
				if(SsaApplyOp.?(x.input0())) {
					condInstr = blockContext.getOptInstr(SsaApplyOp.!(condInstr));
					if (condInstr == null) throwOptInstrNotFound(x.input0());
				}

				if (SsaConst.?(condInstr)) {
					def constCond = SsaConst.!(condInstr);
					def rawCond = Bool.unbox(constCond.val);
					def nextBlock = if(rawCond, x.trueBlock(), x.falseBlock());
					if (DEBUG) Terminal.put1("\tConstant condition: %z\n", rawCond);
					worklist = List<SsaBlock>.new(nextBlock, worklist);
					return;
				} 

				// Eval true block first because it comes first in the SRPO
				if (DEBUG) Terminal.put2("\tVar condition | trueBlock: %d | falseBlock: %d\n", x.trueBlock().uid, x.falseBlock().uid);
				worklist = List<SsaBlock>.new(x.falseBlock(), worklist);
				worklist = List<SsaBlock>.new(x.trueBlock(), worklist);
				return;
			}
			x: SsaGoto => { 
				if (DEBUG) Terminal.put1("SsaGoto uid: %d\n", x.uid);
				def target = x.target();
				if (target.preds.length == 1) {
					if (DEBUG) Terminal.put1("\tGoto target %d has 1 predecessor.\n", target.uid);
					worklist = List<SsaBlock>.new(target, worklist);
					return;
				}
				if (headerToLoop.has(target)) {
					if (DEBUG) Terminal.put1("\tGoto is backedge to loop header target %d. \n", target.uid);
					worklist = List<SsaBlock>.new(target, worklist);
					return;
				}
				/**
				 * Goto target is a merge block with 2 predecessors
				 * Branching must have happened earlier in the CFG
				 * 
				 * Case 1.) True branch targeting merge block; 
				 * 	original condition was variable
				 * Case 2.) True branch targeting merge block;
				 * 	original condition was constant through PE info
				 * Case 3.) False branch targeting merge block
				 * 
				 * Merge block always comes after last block in false branch.
				 * SRPO explores true branch, false branch, then merge block.
				 */
				def curSrpoNum = x.block().info.srpo_num;
				def targetIsNextInSRPO = target.info.srpo_num == curSrpoNum + 1;
				def falseBranchIgnored = worklist != null && (worklist.head.info.srpo_num != x.block().info.srpo_num + 1);
				if (targetIsNextInSRPO || falseBranchIgnored) {
					// Case 2.) and 3.) 
					worklist = List<SsaBlock>.new(target, worklist);
					return;
				} 
				// Case 1.) is noop; follow the worklist
				return;
			}
			_ => return;
		}
	}

	def throwNoLivePredsFound(block: SsaBlock) {
		def msg = Strings.format1("Expected traversal of predecessors before merge block %d.\n", block.uid);
		System.error("PartialEvaluatorException", msg);
	}

	def throwOptInstrNotFound(i: SsaInstr) {
		def msg = Strings.format1("Instruction %d not found in block context\n", i.uid);
		System.error("PartialEvaluationFailedException", msg);
	}

	def throwNoContextsFound(block: SsaBlock) {
		def msg = Strings.format1("Block %d has no context", block.uid);
		System.error("PartialEvaluationException", msg);
	}
}

/**
 * Used to track information about the current iteration of the loop
 * the partial evaluator is in. Tracks the merge blocks that we will 
 * traverse and the predecessors that have been traversed in this iteration.
 */
class LoopIterInfo {
	def info: SsaLoopInfo;
	var mergeBlockMap: PartialMap<SsaBlock, List<SsaBlock>>;

	new (info) {
		newMergeBlockMap();
	}

	def newMergeBlockMap() {
		mergeBlockMap = Ssa.newBlockMap<List<SsaBlock>>();
	}

	def getLivePreds(block: SsaBlock) -> Array<SsaBlock> {
		if (!mergeBlockMap.has(block)) return [];
		return Lists.toArray(mergeBlockMap[block]);
	}
}

type OptMapKey(instr: SsaInstr, inputs: Array<SsaInstr>) {
	/**
	 * Implicitly takes as input an additional OptMapKey when called
	 * off of the type identifier
	 */
	def hash() -> int {
		var hashResult: int = 0;
		match (instr) {
			x: SsaApplyOp => {
				hashResult = x.op.opcode.tag;
			   }
			x: SsaPhi => {
				// There are much less opcodes than this
				hashResult = 300;
			   }
			_ => {
				System.error("PartialEvaluationException", "Unsupported instruction type.\n");
				return -1;
			}
		}
		for (i in inputs) hashResult = hashResult * 33 + i.uid;
		return hashResult;
	}

	/**
	 * Implicitly takes as input an OptMapKey additional when called
	 * off of the type identifier
	 */
	def equals(that: OptMapKey) -> bool {
		match (that.instr) {
			x: SsaApplyOp => {
				if (!SsaApplyOp.?(this.instr)) return false;
				if (x.op != SsaApplyOp.!(this.instr).op) return false;
				return  Arrays.allTrue(this.inputs, that.inputs, SsaInstr.==);
			   }
			x: SsaPhi => return this.instr == that.instr;
			_ => return false;
		}
	}

	def render(buf: StringBuilder) -> StringBuilder {
		match (instr) {
			x: SsaApplyOp => {
				x.op.render(buf);
				buf.puts(" | ");
			   }
			x: SsaPhi => {
				buf.put1("Phi %d | ", x.uid);
			   }
		}
		for (i = 0; i < inputs.length; i++) {
			def instr = inputs[i];
			buf.put1("uid: %d", instr.uid);
			if (i != (inputs.length - 1)) buf.puts(" | ");
		}
		return buf;
	}
}

// PE stands for "Partial Evaluation"
/**
 * Why keep optimization info map for each context? 
 * Alternative: specialize the code
 * MVP: ensure traversal is correct
 * Afterward, it's possible we already have a specialization 
 * we want to continue using. Instead of overspecializing, 
 * it's possible we instead want to assume something is 
 * constant for evaluating but assume different things
 * are constant when specializing
 *
 * How do you use the map: replace all usages with the 
 * instruction we map to.
 */
class PEBlockContext {
	var optMap = HashMap<OptMapKey, SsaInstr>.new(OptMapKey.hash, OptMapKey.equals);
	new(predContext: PEBlockContext) {
		if (predContext != null) optMap = Maps.copy<OptMapKey, SsaInstr>(predContext.optMap);
	}

	def render(buf: StringBuilder) -> StringBuilder {
		buf.puts("opt info map:\n");
		def keyList: List<OptMapKey> = Maps.keyList(optMap);
		for (l = keyList; l != null; l = l.tail) {
			def key = l.head;
			buf.put2("\t(%q)   ->    uid %d\n", key.render, optMap[key].uid);
		}
		buf.puts("end of map\n");
		return buf;
	}
	
	def instrToOptMapKey(instr: SsaInstr) -> OptMapKey {
		def dfEdges = instr.inputs;
		def args = Arrays.map(dfEdges, SsaDfEdge.dest);
		return OptMapKey(instr, args);
	}

	/** 
	 * Returns the instruction with the cached and optimized arguments
	 */
	def optimizeArgs(i: SsaApplyOp) -> SsaApplyOp {
		Terminal.put1("optimize args for %d\n", i.uid);
		Terminal.put1("%q", this.render);
		def newArgs: Array<SsaInstr> = Arrays.map(i.inputs, dfEdgeToInstr);
		for (a in newArgs) {
			Terminal.put1("%d ", a.uid);
		}
		Terminal.put("\n");
		// TODO: transfer facts
		return SsaApplyOp.new(null, i.op, newArgs);
	}

	def addApplyOp(i: SsaApplyOp, instrReducer: SsaInstrReducer) -> SsaInstr {
		def copy = optimizeArgs(i);
		def key: OptMapKey = instrToOptMapKey(copy);
		// Check if instr is already in map
		if (optMap.has(key)) {
			return optMap[key];
		}
		def reducedInstr = instrReducer.reduceApplyOp(copy);
		Terminal.put3("uid %d : (%q)   ->   uid %d\n", i.uid, key.render, reducedInstr.uid);
		optMap[key] = reducedInstr;
		return reducedInstr;
	}

	def addPhi(phi: SsaPhi, cur: SsaInstr) {
		def key: OptMapKey = instrToOptMapKey(phi);
		optMap[key] = cur;
	}

	def throwOptInstrNotFound(i: SsaInstr) {
		def msg = Strings.format1("Instruction %d not found in block context\n", i.uid);
		System.error("PartialEvaluationFailedException", msg);
	}
	/**
	 * Mapping function over the list of dfEdges for an instruction.
	 */
	private def dfEdgeToInstr(dfEdge: SsaDfEdge) -> SsaInstr {
		if (SsaConst.?(dfEdge.dest)) return dfEdge.dest;
		if (!hasOptInstr(dfEdge.dest)) {
			Terminal.put2("\tInstr %d with key (%q) not found in map\n", dfEdge.dest.uid, instrToOptMapKey(dfEdge.dest).render);
			return dfEdge.dest;
		}
		def resultInstr = getOptInstr(dfEdge.dest);
		if (resultInstr == null) throwOptInstrNotFound(dfEdge.dest);
		return resultInstr;
	}

	def hasOptInstr(i: SsaInstr) -> bool {
		def key = instrToOptMapKey(i);
		return optMap.has(key);
	}

	def getOptInstr(i: SsaInstr) -> SsaInstr {
		if (SsaConst.?(i)) return i;
		var instr = i;
		if (SsaApplyOp.?(i)) {
			instr = optimizeArgs(SsaApplyOp.!(i));
		}
		def key = instrToOptMapKey(instr);
		Terminal.put2("getOptInstr | instr uid: %d | key: %q\n", i.uid, key.render);
		if (!optMap.has(key)) return null;
		return optMap[key];
	}
}

